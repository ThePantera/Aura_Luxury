// Esquema de datos de Perfum Luxury (Fase 1 del Prompt de Fases).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  Arabian
  Designer
  Niche
  Decant
}

enum Presentation {
  Cerrado
  Tester
  MiniTalla @map("Mini Talla")
}

enum Usage {
  Gym
  Office
  Night
  Summer
  Winter
}

enum Gender {
  Masculino
  Femenino
  Unisex
}

enum Badge {
  BestSeller @map("Best Seller")
  Viral
  Offer
  None
}

model Product {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  brand            String
  category         Category
  gender           Gender       @default(Unisex)
  presentation     Presentation @default(Cerrado)
  priceARS         Decimal      @db.Decimal(12, 2)
  priceUSD         Decimal      @db.Decimal(10, 2)
  topNotes         String[]
  heartNotes       String[]
  baseNotes        String[]
  recommendedUsage Usage[]
  durationHours    Int
  badge            Badge        @default(None)
  imageUrl         String
  stock            Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([category])
}

// Ajustes generales editables desde /admin (una sola fila, id = 1).
model Setting {
  id            Int      @id @default(1)
  usdRate       Decimal  @db.Decimal(12, 2)
  whatsappPhone String
  updatedAt     DateTime @updatedAt
}
