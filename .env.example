# Cadena de conexión a PostgreSQL (local, Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL="postgresql://usuario:password@localhost:5432/perfum_luxury?schema=public"

# Acceso al panel /admin
ADMIN_USER="admin"
ADMIN_PASSWORD="cambiar-esta-clave"
# Clave para firmar la sesión: al menos 32 caracteres al azar (ej. `openssl rand -base64 32`)
AUTH_SECRET=""
